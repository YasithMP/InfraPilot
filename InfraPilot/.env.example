# `infrapilot` reads credentials from ~/.infrapilot/.env (or your real shell
# environment). Copy this file there and choose one authentication method:
#   Windows PowerShell: Copy-Item InfraPilot\.env.example $HOME\.infrapilot\.env
#   macOS/Linux:         mkdir -p ~/.infrapilot && cp InfraPilot/.env.example ~/.infrapilot/.env

# Google AI Studio
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-api-key

# Optional model override
# INFRAPILOT_MODEL=gemini-3.1-pro-preview

# Vertex AI (use these instead of GOOGLE_API_KEY)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

